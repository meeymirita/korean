{
  "name": "korean",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" -- && npm run prerender",
    "preview": "vite preview",
    "server": "npm --prefix server start",
    "build-only": "vite build",
    "prerender": "node scripts/prerender.mjs",
    "type-check": "vue-tsc --build",
    "test": "npm run server:build && node --test \"tests/*.test.mjs\"",
    "server:build": "npm --prefix server run build",
    "server:dev": "npm --prefix server run dev"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "npm-run-all2": "^9.0.4",
    "typescript": "~6.0.0",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
