# Скопируй этот файл в server/.env (файл .env в git не попадает) и вставь свой токен.
# Создать случайный токен: openssl rand -base64 24
# Или без openssl: node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
PROGRESS_TOKEN=token

# Почта для кодов входа (двухфакторная защита, включается в кабинете). Пароль почты кладёшь только сюда. Порт 465 — сразу шифрованное соединение, 587 — STARTTLS.
# SMTP_HOST=smtp.yandex.ru
# SMTP_PORT=465
# SMTP_USER=ящик@домен
# SMTP_PASS=пароль-приложения
# SMTP_FROM="우리말 <ящик@домен>"
# Аварийный выход, если письма перестали приходить: раскомментируй, перезапусти службу, войди по одному токену, потом убери строку и перезапусти снова.
# DISABLE_2FA=1

# Журнал Caddy во вкладке «Журналы» кабинета: путь к файлу журнала доступа в формате JSON (см. docs/hosting.md). Без него показывается только журнал сервера.
# CADDY_LOG_FILE=/var/log/caddy/korean.log

# Полный архив по кнопке в «Настройках» (и раз в неделю сам): шифруется паролем и уходит на Яндекс Диск и на почту.
# BACKUP_PASSPHRASE=длинная-фраза   (сохраните копию у себя: без неё архив не открыть)
# YADISK_LOGIN=логин@yandex.ru
# YADISK_PASSWORD=пароль-приложения   (id.yandex.ru/security/app-passwords → тип «Файлы WebDAV», это НЕ пароль от почты)
# YADISK_DIR=backup_korean
# BACKUP_MAIL_TO=адрес@почта   (по умолчанию почта из двухфакторной защиты)
# BACKUP_AUTO=0   (выключить автозапуск раз в неделю)
