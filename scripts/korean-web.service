# Служба сайта на Nuxt (отрисовка страниц на сервере). Установка на сервере (из папки проекта):
#   cp scripts/korean-web.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now korean-web
# Сайт слушает только 127.0.0.1:3000, наружу его выставляет Caddy; API остаётся службой progress (порт 3001).
[Unit]
Description=korean.meeymirita.ru: сайт (Nuxt SSR)
After=network.target progress.service

[Service]
WorkingDirectory=/var/sites/korean
ExecStart=/usr/bin/node .output/server/index.mjs
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3000
# куда сайт ходит за данными API при отрисовке на сервере (визитка /me)
Environment=NUXT_API_BASE=http://127.0.0.1:3001
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
