# Вход «всё в одном» для профиля edge (docker compose --profile edge up -d). Повторяет блок сайта из боевого Caddy (docs/hosting.md):
# те же заголовки безопасности, лимит тела запроса, кэш и видео. DOMAIN=localhost даёт локальный сертификат Caddy.
{$DOMAIN:localhost} {
	encode zstd gzip
	log {
		output file /var/log/caddy/korean.log {
			mode 640
			roll_size 20MiB
			roll_keep 5
		}
		format json
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		-Server
	}
	request_body {
		max_size 60MB
	}
	@assets path /_nuxt/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@pages path / /index.html /sitemap.xml /robots.txt /manifest.webmanifest
	header @pages Cache-Control "no-cache"
	# метрики для Prometheus снаружи не нужны
	@metrics path /api/metrics
	handle @metrics {
		respond 404
	}
	handle /api/* {
		reverse_proxy backend:3001
	}
	handle_path /video/* {
		root * /srv/video
		header Cache-Control "public, max-age=86400"
		file_server
	}
	handle {
		reverse_proxy frontend:3000
	}
}
