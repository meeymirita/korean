    {
      "id": 9,
      "type": "timeseries",
      "title": "Что делает процессор",
      "description": "Из чего сложена нагрузка. Чем выше линии, тем больше занят процессор",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 1.5,
            "fillOpacity": 45,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * sum(rate(node_cpu_seconds_total{mode=~\"user|nice\"}[2m])) / scalar(count(count by (cpu) (node_cpu_seconds_total)))",
          "legendFormat": "Работают программы",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * sum(rate(node_cpu_seconds_total{mode=~\"system|irq|softirq\"}[2m])) / scalar(count(count by (cpu) (node_cpu_seconds_total)))",
          "legendFormat": "Работает сама система",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * sum(rate(node_cpu_seconds_total{mode=\"iowait\"}[2m])) / scalar(count(count by (cpu) (node_cpu_seconds_total)))",
          "legendFormat": "Ждёт диск",
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * sum(rate(node_cpu_seconds_total{mode=\"steal\"}[2m])) / scalar(count(count by (cpu) (node_cpu_seconds_total)))",
          "legendFormat": "Забирает хостинг",
          "refId": "D"
        }
