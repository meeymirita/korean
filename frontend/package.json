{
  "name": "korean-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "node .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "type-check": "nuxt typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=text-summary --coverage.include=src --maxWorkers=1"
  },
  "dependencies": {
    "@nuxtjs/robots": "^7.0.2",
    "@nuxtjs/sitemap": "^9.1.0",
    "@pinia/nuxt": "^1.0.3",
    "gsap": "^3.15.0",
    "nuxt": "^4.6.3",
    "nuxt-schema-org": "^7.0.1",
    "perfect-freehand": "^1.2.3",
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@nuxt/test-utils": "^4.3.4",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "happy-dom": "^21.0.4",
    "typescript": "~6.0.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents": false
  }
