# Настройки Docker-стека. Не редактируй руками с нуля: `bash scripts/init-env.sh` создаёт .env с новыми случайными паролями
# (а `bash scripts/init-env.sh --from backend.env` подхватывает токен, почту и ключи из прежнего backend/.env).
# .env в git не попадает; копия лежит в резервной копии (config/) и в полном архиве.

# --- Проект и доступ ---
COMPOSE_PROJECT_NAME=korean
TZ=Asia/Novosibirsk
# Сайт и API слушают только 127.0.0.1: на сервере их открывает уже стоящий Caddy (блок korean.meeymirita.ru, см. docs/hosting.md).
FRONTEND_PORT=3000
BACKEND_PORT=3001
# Профиль edge (необязательно): свой Caddy в Docker, `docker compose --profile edge up -d`. На сервере с хостовым Caddy не включать (заняты 80/443).
DOMAIN=localhost
HTTP_PORT=80
HTTPS_PORT=443
# Папка с видеоуроками для профиля edge (на сервере /var/sites/korean-video)
VIDEO_DIR=./docker/caddy/video
# Grafana открыта только на 127.0.0.1 (с ноутбука через ssh -L 3002:127.0.0.1:3002 сервер)
GRAFANA_PORT=3002
# Адрес Grafana снаружи (нужен для входа и ссылок); на сервере https://grafana.korean.meeymirita.ru
GRAFANA_URL=http://127.0.0.1:3002
PROMETHEUS_PORT=9090
MEILI_PORT=7700
GRAFANA_USER=admin
GRAFANA_PASSWORD=replace-with-a-long-random-secret
# Сокет Docker для read-only прокси состояния контейнеров (вкладка «Сервисы» в кабинете)
DOCKER_SOCKET_PATH=/var/run/docker.sock

# --- Приложение (прежний backend/.env) ---
PROGRESS_TOKEN=replace-with-a-long-random-secret
SITE_URL=https://korean.meeymirita.ru
OPENROUTER_API_KEY=
CHAT_MODEL=
CHAT_BASE=https://openrouter.ai/api/v1
CHAT_DAILY_LIMIT=40
SWAGGER=0
DISABLE_2FA=0
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
REMINDER_MAIL_TO=
# --- Яндекс.Диск: копии сайта, база с .env, картинки, видео (токен с правом cloud_api:disk.app_folder) ---
YADISK_TOKEN=
# папка внутри «Приложения/<название>» (пусто = корень); YADISK_KEEP — сколько дат копий хранить
YADISK_ROOT=
YADISK_KEEP=14
# --- Telegram: все уведомления (бот из @BotFather; чат: написать боту /start и открыть api.telegram.org/bot<токен>/getUpdates) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Группа с темами (числа из getUpdates; бот админ с правом «Управление темами»). Без группы всё идёт в личный чат
TELEGRAM_GROUP_ID=
TELEGRAM_TOPIC_LOGIN=
TELEGRAM_TOPIC_REMIND=
TELEGRAM_TOPIC_DIGEST=
TELEGRAM_TOPIC_LESSON=
TELEGRAM_TOPIC_BACKUP=
TELEGRAM_TOPIC_ALERT=
# 1 = код входа тоже в тему «Вход» (его увидят все в группе); по умолчанию код только в личном чате
TELEGRAM_LOGIN_TO_GROUP=
# Вход по токену живёт столько часов, потом токен вводится заново (0 = без ограничения)
OWNER_SESSION_HOURS=4
BACKUP_MAIL_TO=
BACKUP_PASSPHRASE=
BACKUP_AUTO=1
BACKUP_EVERY_DAYS=1
BACKUP_WATCH_MS=3600000
KEEP=14
KEEP_OFFSITE_DAYS=30
OFFSITE_RSYNC=
OFFSITE_RCLONE=
LESSON_TICK_MS=60000
DOCS_QUOTA_MB=1024
IMAGES_QUOTA_MB=1024

# --- База, очередь и поиск (пароли только латиница и цифры: они попадают в адреса подключения) ---
POSTGRES_DB=korean
POSTGRES_USER=korean
POSTGRES_PASSWORD=replace-with-a-long-random-secret
REDIS_PASSWORD=replace-with-a-long-random-secret
MEILI_ENV=production
MEILI_MASTER_KEY=replace-with-a-long-random-secret

# --- Версии образов ---
BACKEND_IMAGE=local/korean-backend:latest
FRONTEND_IMAGE=local/korean-frontend:latest
# имя службы API для сборки сайта (рисование на сервере ходит к нему по внутренней сети)
FRONTEND_API_HOST=backend
POSTGRES_IMAGE=postgres:17-alpine
REDIS_IMAGE=redis:7.4-alpine
MEILISEARCH_IMAGE=getmeili/meilisearch:v1.12
CADDY_IMAGE=caddy:2-alpine
PROMETHEUS_IMAGE=prom/prometheus:v3.5.0
GRAFANA_IMAGE=grafana/grafana:12.1.1
NODE_EXPORTER_IMAGE=prom/node-exporter:v1.9.1
DOCKER_PROXY_IMAGE=tecnativa/docker-socket-proxy:0.3.0
PROMETHEUS_RETENTION=15d
