# Hostname served by Caddy (DNS must point here). Use localhost for local development.
DOMAIN=localhost
COMPOSE_PROJECT_NAME=korean

# Required; replace with a long random password before starting the stack.
GRAFANA_PASSWORD=replace-with-a-long-random-secret
GRAFANA_USER=admin
GRAFANA_PORT=3002

# Optional host directory for SQLite database, uploads, and backup status.
APP_DATA_DIR=./backend/data

# Database, queue/cache, and search
POSTGRES_DB=korean
POSTGRES_USER=korean
POSTGRES_PASSWORD=replace-with-a-long-random-secret
REDIS_PASSWORD=replace-with-a-long-random-secret
MEILI_ENV=production
MEILI_MASTER_KEY=replace-with-a-long-random-secret
